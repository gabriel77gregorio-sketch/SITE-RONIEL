</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6.5rem 1.25rem 3rem;
    background: var(--black, #0a0a0a);
    overflow: hidden;
  }

  .hero-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: url('/hero-desktop.jpg') center top / cover no-repeat;
    filter: brightness(0.12) saturate(0.2) contrast(1.1);
    z-index: 0;
    animation: heroZoom 20s ease-in-out infinite alternate;
  }

  @keyframes heroZoom {
    0% { transform: scale(1); }
    100% { transform: scale(1.08); }
  }

  .hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: 
      radial-gradient(ellipse at 30% 50%, rgba(26, 42, 74, 0.2) 0%, transparent 60%),
      radial-gradient(ellipse at 70% 30%, rgba(192, 192, 192, 0.04) 0%, transparent 50%),
      linear-gradient(180deg, rgba(10,10,10,0.3) 0%, rgba(10,10,10,0.6) 100%);
    z-index: 1;
  }

  .hero-glow-top {
    position: absolute;
    top: -20%;
    left: 50%;
    transform: translateX(-50%);
    width: 500px;
    height: 350px;
    background: radial-gradient(circle, rgba(192, 192, 192, 0.06) 0%, transparent 70%);
    z-index: 1;
    pointer-events: none;
  }

  .hero-glow-bottom {
    position: absolute;
    bottom: -10%;
    left: 30%;
    width: 400px;
    height: 300px;
    background: radial-gradient(circle, rgba(26, 42, 74, 0.1) 0%, transparent 70%);
    z-index: 1;
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 850px;
    width: 100%;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0 0.25rem;
  }

  /* Glass Badge */
  .glass-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 50px;
    padding: 0.4rem 0.9rem;
    margin-bottom: 1.5rem;
    background: rgba(255, 255, 255, 0.06);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    box-shadow: 
      0 4px 16px rgba(0, 0, 0, 0.2),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    min-width: 6px;
    border-radius: 50%;
    background: #4ade80;
    box-shadow: 0 0 8px rgba(74, 222, 128, 0.5);
    animation: dotPulse 2s ease-in-out infinite;
  }

  @keyframes dotPulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }

  .glass-badge span {
    color: var(--silver-light, #d4d4d4);
    font-size: 0.6rem;
    font-family: 'Inter', sans-serif;
    font-weight: 400;
    letter-spacing: 0.02em;
    line-height: 1.3;
  }

  .headline {
    color: var(--white, #ffffff);
    font-family: 'Playfair Display', serif;
    font-size: 1.75rem;
    line-height: 1.3;
    margin-bottom: 1rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .highlight {
    background: linear-gradient(135deg, #ffffff 0%, #c0c0c0 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .sub-headline {
    color: var(--silver, #c0c0c0);
    font-family: 'Inter', sans-serif;
    font-size: 0.875rem;
    line-height: 1.7;
    margin-bottom: 2rem;
    font-weight: 300;
  }

  /* Actions */
  .hero-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    max-width: 360px;
    margin-bottom: 0.75rem;
  }

  .cta-button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    background: var(--white, #ffffff);
    color: var(--black, #0a0a0a);
    padding: 0.85rem 1.5rem;
    border-radius: 10px;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.85rem;
    font-family: 'Inter', sans-serif;
    transition: all 0.3s ease;
    letter-spacing: 0.01em;
    position: relative;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(255, 255, 255, 0.08);
  }

  .cta-icon {
    flex-shrink: 0;
  }

  .cta-button::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.4), transparent);
    transition: left 0.7s ease;
  }

  .cta-button:hover::before {
    left: 100%;
  }

  .cta-button:hover {
    background: var(--silver-light, #d4d4d4);
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(255, 255, 255, 0.12);
  }

  .cta-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--silver-dark, #8a8a8a);
    font-size: 0.8rem;
    text-decoration: none;
    font-weight: 400;
    transition: color 0.3s ease;
    font-family: 'Inter', sans-serif;
  }

  .cta-secondary:hover {
    color: var(--white, #ffffff);
  }

  .micro-copy {
    color: var(--silver-dark, #8a8a8a);
    font-size: 0.65rem;
    font-family: 'Inter', sans-serif;
    font-weight: 300;
    margin-bottom: 1.75rem;
    line-height: 1.4;
  }

  /* Trust Bar */
  .trust-bar {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
  }

  .glass-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.75rem;
    border-radius: 50px;
    background: rgba(255, 255, 255, 0.04);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.07);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05);
  }

  .glass-pill svg {
    color: var(--silver-dark, #8a8a8a);
    flex-shrink: 0;
  }

  .glass-pill span {
    color: var(--silver-dark, #8a8a8a);
    font-size: 0.6rem;
    font-family: 'Inter', sans-serif;
    font-weight: 400;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  /* Tablet (480px+) */
  @media (min-width: 480px) {
    .hero {
      padding: 7rem 1.5rem 3rem;
    }

    .glass-badge span {
      font-size: 0.7rem;
    }

    .headline {
      font-size: 2.25rem;
      line-height: 1.25;
    }

    .sub-headline {
      font-size: 0.95rem;
    }

    .cta-button {
      font-size: 0.9rem;
      padding: 0.9rem 1.75rem;
    }

    .trust-bar {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.5rem;
    }

    .glass-pill span {
      font-size: 0.65rem;
    }

    .micro-copy {
      font-size: 0.7rem;
    }
  }

  /* Tablet large (768px+) */
  @media (min-width: 768px) {
    .headline {
      font-size: 2.75rem;
    }

    .sub-headline {
      font-size: 1.05rem;
      max-width: 90%;
    }

    .glass-badge span {
      font-size: 0.8rem;
    }

    .glass-pill span {
      font-size: 0.7rem;
    }
  }

  /* Desktop (1024px+) */
  @media (min-width: 1024px) {
    .hero {
      height: 100vh;
      padding: 0 2rem;
    }

    .headline {
      font-size: clamp(2.75rem, 4vw, 3.75rem);
      line-height: 1.18;
      letter-spacing: -0.02em;
    }

    .sub-headline {
      font-size: 1.125rem;
      max-width: 100%;
    }

    .hero-actions {
      flex-direction: row;
      justify-content: center;
      width: auto;
      max-width: none;
      gap: 1rem;
    }

    .cta-button {
      width: auto;
      padding: 1rem 2rem;
      font-size: 0.95rem;
    }
    
    .glass-badge span {
      font-size: 0.85rem;
    }

    .hero-glow-top {
      width: 1200px;
      height: 700px;
    }

    .hero-glow-bottom {
      width: 600px;
      height: 400px;
    }

    .glass-pill span {
      font-size: 0.75rem;
    }

    .micro-copy {
      font-size: 0.75rem;
    }
  }
</style>
