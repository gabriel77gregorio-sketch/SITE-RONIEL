---
// Footer.astro
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      
      <!-- Coluna 1: Institucional -->
      <div class="footer-col brand-col">
        <a href="#inicio" class="footer-logo-link">
          <img src="/logo-header.png" alt="Roniell & Almeida - Advocacia e Consultoria" class="footer-logo" />
        </a>
        <p class="registry">Dr. Cleber Almeida — OAB/SP 534.294</p>
      </div>

      <!-- Coluna 2: Links Rápidos -->
      <div class="footer-col links-col">
        <h3 class="col-title">Links Rápidos</h3>
        <nav class="footer-nav">
          <a href="/#areas">Áreas de Atuação</a>
          <a href="/#escritorio">O Escritório</a>
          <a href="/#contato">Contato</a>
          <a href="/politica-de-privacidade">Política de Privacidade</a>
          <a href="https://wa.me/5511980913894?text=Ol%C3%A1!%20Gostaria%20de%20uma%20orienta%C3%A7%C3%A3o%20jur%C3%ADdica" target="_blank" rel="noopener noreferrer">WhatsApp</a>
        </nav>
      </div>

      <!-- Coluna 3: Contato -->
      <div class="footer-col contact-col">
        <h3 class="col-title">Contato</h3>
        <div class="contact-details">
          <p>Av. Vida Nova, 28 – Sala 412B – Jardim Maria Rosa, Taboão da Serra - SP, 06764-045</p>
          <p>(11) 98091-3894</p>
          <p>Segunda a Sexta, das 09h às 18h</p>
        </div>
      </div>

    </div>

    <!-- Barra Inferior -->
    <div class="footer-bottom">
      <p class="ethics-text">
        Este site possui caráter meramente informativo e orientativo, em conformidade com o Código de Ética e Disciplina da OAB.
      </p>
      <div class="footer-legal">
        <p class="copyright">
          &copy; 2025 Roniell & Almeida Advocacia e Consultoria. Todos os direitos reservados.
        </p>
        <span class="divider-dot">•</span>
        <a href="/politica-de-privacidade" class="privacy-link">Política de Privacidade (LGPD)</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--black, #0a0a0a);
    color: var(--white, #ffffff);
    padding: 3rem 1.5rem 1.5rem;
    position: relative;
  }

  .site-footer::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(192, 192, 192, 0.15), transparent);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .footer-grid {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    text-align: center;
    margin-bottom: 3rem;
  }

  /* Logo */
  .footer-logo-link {
    display: inline-block;
    margin-bottom: 0.75rem;
  }

  .footer-logo {
    height: 52px;
    width: auto;
    object-fit: contain;
    margin: 0 auto;
    opacity: 0.95;
    transition: opacity 0.3s ease;
  }

  .footer-logo:hover {
    opacity: 1;
  }

  .brand-col .registry {
    color: var(--silver-dark, #8a8a8a);
    font-size: 0.8rem;
    margin: 0;
  }

  /* Títulos das colunas */
  .col-title {
    color: var(--white, #ffffff);
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin: 0 0 1.25rem 0;
    font-family: 'Inter', sans-serif;
  }

  /* Coluna Links */
  .footer-nav {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer-nav a {
    color: var(--silver-dark, #8a8a8a);
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.3s ease;
    font-weight: 300;
  }

  .footer-nav a:hover {
    color: var(--white, #ffffff);
  }

  /* Coluna Contato */
  .contact-details {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .contact-details p {
    color: var(--silver-dark, #8a8a8a);
    font-size: 0.9rem;
    margin: 0;
    line-height: 1.4;
    font-weight: 300;
  }

  /* Barra inferior */
  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding-top: 1.5rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .ethics-text {
    color: rgba(255, 255, 255, 0.3);
    font-size: 0.75rem;
    margin: 0;
    line-height: 1.5;
  }

  .footer-legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }

  .copyright {
    color: rgba(255, 255, 255, 0.35);
    font-size: 0.75rem;
    margin: 0;
  }

  .divider-dot {
    color: rgba(255, 255, 255, 0.2);
    font-size: 0.75rem;
  }

  .privacy-link {
    color: var(--silver, #c0c0c0);
    font-size: 0.75rem;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.2s ease;
  }

  .privacy-link:hover {
    color: var(--white, #ffffff);
  }

  /* Desktop */
  @media (min-width: 1024px) {
    .site-footer {
      padding: 4rem 2rem 2rem;
    }

    .footer-grid {
      flex-direction: row;
      justify-content: space-between;
      text-align: left;
      gap: 2rem;
    }

    .footer-logo {
      margin: 0;
    }

    .brand-col {
      max-width: 300px;
    }

    .contact-col {
      max-width: 350px;
    }
  }
</style>
