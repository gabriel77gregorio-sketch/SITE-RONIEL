---
// Footer.astro
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      
      <!-- Coluna 1: Institucional -->
      <div class="footer-col brand-col">
        <h2 class="logo">Roniell & Almeida</h2>
        <p class="subtitle">Advocacia e Consultoria</p>
        <p class="registry">OAB/SP nº [Inserir Registro] | CNPJ: [Inserir se houver]</p>
      </div>

      <!-- Coluna 2: Links Rápidos -->
      <div class="footer-col links-col">
        <h3 class="col-title">Links Rápidos</h3>
        <nav class="footer-nav">
          <a href="#">Políticas de Privacidade</a>
          <a href="#contato">Contato</a>
          <a href="https://wa.me/5511980913894?text=Ol%C3%A1!%20Gostaria%20de%20uma%20orienta%C3%A7%C3%A3o%20jur%C3%ADdica" target="_blank" rel="noopener noreferrer">WhatsApp</a>
        </nav>
      </div>

      <!-- Coluna 3: Contato -->
      <div class="footer-col contact-col">
        <h3 class="col-title">Contato</h3>
        <div class="contact-details">
          <p>Av. Vida Nova, 28 – Sala 412B – Jardim Maria Rosa, Taboão da Serra - SP, 06764-045</p>
          <p>(11) 98091-3894</p>
          <p>Segunda a Sexta, das 09h às 18h</p>
        </div>
      </div>

    </div>

    <!-- Barra Inferior -->
    <div class="footer-bottom">
      <p class="ethics-text">
        Este site possui caráter meramente informativo e orientativo, em conformidade com o Código de Ética e Disciplina da OAB.
      </p>
      <p class="copyright">
        &copy; 2025 Roniell & Almeida. Todos os direitos reservados.
      </p>
    </div>
  </div>
</footer>

<style>
  :root {
    --navy: #0d2137;
    --petrol: #1a3a5c;
    --gold: #b8943e;
    --gray-light: #f4f5f7;
    --gray-medium: #6b7280;
    --white: #ffffff;
    --graphite: #374151;
  }

  .site-footer {
    background-color: var(--navy);
    color: var(--white);
    padding: 3rem 1.5rem 1.5rem;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .footer-grid {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    text-align: center;
    margin-bottom: 3rem;
  }

  /* Coluna Institucional */
  .brand-col .logo {
    font-family: 'Playfair Display', serif;
    font-size: 1.75rem;
    color: var(--white);
    margin: 0 0 0.25rem 0;
  }

  .brand-col .subtitle {
    color: var(--gold);
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin: 0 0 1rem 0;
  }

  .brand-col .registry {
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.85rem;
    margin: 0;
  }

  /* Títulos das colunas */
  .col-title {
    color: var(--white);
    font-size: 0.9rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin: 0 0 1.25rem 0;
  }

  /* Coluna Links */
  .footer-nav {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer-nav a {
    color: var(--gray-medium);
    text-decoration: none;
    font-size: 0.95rem;
    transition: color 0.2s ease;
  }

  .footer-nav a:hover {
    color: var(--gold);
  }

  /* Coluna Contato */
  .contact-details {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .contact-details p {
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.95rem;
    margin: 0;
    line-height: 1.4;
  }

  /* Barra inferior */
  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: 1.5rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .ethics-text {
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.8rem;
    margin: 0;
    line-height: 1.5;
  }

  .copyright {
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.8rem;
    margin: 0;
  }

  /* Desktop */
  @media (min-width: 1024px) {
    .site-footer {
      padding: 4rem 2rem 2rem;
    }

    .footer-grid {
      flex-direction: row;
      justify-content: space-between;
      text-align: left;
      gap: 2rem;
    }

    .brand-col {
      max-width: 300px;
    }

    .contact-col {
      max-width: 350px;
    }
  }
</style>
